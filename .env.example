# Copy to .env.local for local development.
# Set these in Vercel Project Settings -> Environment Variables.
# Use the Supabase Project URL and publishable/anon key from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional demo login UI. Enable only on Preview deployments.
# These values are public in the browser bundle; use a disposable, restricted demo account.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_DEMO_EMAIL=demo@example.com
NEXT_PUBLIC_DEMO_PASSWORD=REPLACE_WITH_A_DISPOSABLE_DEMO_PASSWORD
