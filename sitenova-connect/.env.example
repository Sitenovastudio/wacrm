# SiteNova Connect local development — never commit the real .env file.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Dedicated self-hosted InsForge instance (local only by default)
INSFORGE_BASE_URL=http://localhost:7130
INSFORGE_PROJECT_ID=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# Server-only credentials. Do not expose these to browser bundles.
INSFORGE_ADMIN_KEY=
INSFORGE_DATABASE_URL=

# WhatsApp / Meta — server only
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
ENCRYPTION_KEY=

# AI provider credentials — server only
AI_PROVIDER=
AI_API_KEY=

# Durable worker controls
WORKER_ENABLED=false
CRON_SECRET=
